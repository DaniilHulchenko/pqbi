             </dx-select-box>
 
             <dx-number-box [(value)]="valueFont.size" placeholder="font size" [min]="8" [max]="50">
             </dx-number-box>
 
             <div class="font-color">
               <label>font color</label>
               <dx-color-box [(value)]="valueFont.customColor" [editAlphaChannel]="true"></dx-color-box>
             </div>
